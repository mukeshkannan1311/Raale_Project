# PharmaTrace Backend Environment Variables Example
# Duplicate this file as .env in the backend folder or project root

# Database Connection
# PostgreSQL: postgresql://pharmatrace:pharmatrace_password@localhost:5432/pharmatrace_db
# SQLite (Zero-config local fallback): sqlite:///./pharmatrace.db
DATABASE_URL=sqlite:///./pharmatrace.db

# Security & Tokens
JWT_SECRET=pharmatrace-secret-key-college-2026-super-secure
ENVIRONMENT=development
PORT=8000
